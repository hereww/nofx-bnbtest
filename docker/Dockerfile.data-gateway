ARG GO_VERSION=m.daocloud.io/docker.io/library/golang:1.25-alpine
ARG ALPINE_VERSION=m.daocloud.io/docker.io/library/alpine:3.20

FROM ${GO_VERSION} AS builder

ENV GOPROXY=https://goproxy.cn,direct
RUN sed -i 's|https://dl-cdn.alpinelinux.org/alpine|https://mirrors.aliyun.com/alpine|g' /etc/apk/repositories
RUN apk update && apk add --no-cache git gcc g++ musl-dev

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o nofx-data-gateway ./cmd/data-gateway

FROM ${ALPINE_VERSION}

RUN sed -i 's|https://dl-cdn.alpinelinux.org/alpine|https://mirrors.aliyun.com/alpine|g' /etc/apk/repositories
RUN apk update && apk add --no-cache ca-certificates tzdata sqlite wget

WORKDIR /app
COPY --from=builder /app/nofx-data-gateway .

EXPOSE 8090

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8090/health || exit 1

CMD ["./nofx-data-gateway"]
