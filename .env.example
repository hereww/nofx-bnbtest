# NOFX Environment Variables Template
# Copy this file to .env and modify the values as needed

# ===========================================
# Server Configuration
# ===========================================

# Backend API server port
NOFX_BACKEND_PORT=8080

# Frontend web interface port
NOFX_FRONTEND_PORT=3000

# Timezone
NOFX_TIMEZONE=Asia/Shanghai

# ===========================================
# Authentication (Required)
# ===========================================

# JWT signing secret (any random string, at least 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-change-this-in-production

# ===========================================
# Encryption Keys (Required)
# ===========================================

# AES-256 data encryption key (Base64 encoded, 32 bytes)
# Used for encrypting sensitive data in database (API keys, secrets)
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# RSA private key for client-server encryption (PEM format)
# Used for end-to-end encryption of sensitive data from browser
# Generate with: openssl genrsa 2048
# Note: Replace newlines with \n for single-line format
RSA_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----

# ===========================================
# Security Options
# ===========================================

# Transport encryption for API keys (default: false)
# When enabled, browser uses Web Crypto API to encrypt API keys before sending
# Requires HTTPS or localhost to work
# Set to true for enhanced security (HTTPS required)
# Set to false for easier deployment (HTTP/IP access allowed)
TRANSPORT_ENCRYPTION=false

# ===========================================
# Optional: External Services
# ===========================================

# Self-hosted NofxOS-compatible market data gateway.
# Leave DATA_GATEWAY_TOKEN empty for local open access, or set a shared token
# and requests will require X-Gateway-Token or ?auth=.
DATA_GATEWAY_URL=http://127.0.0.1:8090
DATA_GATEWAY_TOKEN=
DATA_GATEWAY_PORT=8090
DATA_GATEWAY_DB_PATH=data/data-gateway.db
DATA_GATEWAY_REFRESH_INTERVAL=1m

# On-chain token analysis indexer.
# Free local early-wallet indexing is enabled by default. Archive RPC is only
# required for full-history analysis or faster/more complete historical backfill.
ONCHAIN_INDEXER_ENABLED=false
ONCHAIN_INDEXER_URL=http://127.0.0.1:8091
ONCHAIN_INDEXER_ADDR=:8091
ONCHAIN_INDEXER_DB_PATH=data/onchain-indexer.db
ONCHAIN_BSC_ARCHIVE_RPC_URL=
# Example: https://bsc-archive.example.com or any BSC archive RPC with full history access.
ONCHAIN_INDEXER_POLL_INTERVAL_SECONDS=15
ONCHAIN_INDEXER_BATCH_BLOCKS=100
ONCHAIN_FREE_INDEXER_ENABLED=true
# Comma-separated free/public BSC RPC URLs. These are only used for lightweight
# calls and small-range fallback logs; Etherscan V2 remains the historical log source.
ONCHAIN_FREE_RPC_URLS=https://bsc-rpc.publicnode.com,https://binance.llamarpc.com,https://bsc-dataseed.binance.org,https://bsc-dataseed1.binance.org,https://bsc-dataseed2.binance.org
ONCHAIN_FREE_BACKFILL_MAX_REQUESTS_PER_TICK=200
ONCHAIN_FREE_BACKFILL_TARGET_SEEDS=100
# Free seed source. Etherscan V2 is the historical log source; GeckoTerminal is a recent public-data fallback.
ONCHAIN_FREE_LOG_SOURCE=etherscan,gecko
ONCHAIN_GECKO_TRADES_LIMIT=300
ONCHAIN_ETHERSCAN_API_KEY=
ONCHAIN_ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
ONCHAIN_FREE_LOGS_RPS=2
ONCHAIN_FREE_LOGS_DAILY_BUDGET=90000
ONCHAIN_LOG_PAGE_SIZE=1000
ONCHAIN_EARLY_WINDOW_BLOCKS=100000
# Optional explicit proxy for DexScreener/GoPlus/GeckoTerminal/Etherscan
# requests when the server cannot directly access those APIs.
# This is intentionally separate from HTTP_PROXY/HTTPS_PROXY, which may be
# used for AI providers or exchange SDKs.
# Example: http://user:pass@host:port
# If /onchain shows "context deadline exceeded" for api.dexscreener.com,
# set this to a proxy reachable from the backend container/server.
MARKET_HTTP_PROXY=
ONCHAIN_ARCHIVE_HTTP_PROXY=

# Optional Docker-local fixed egress proxy. When data/proxy/sing-box.json
# exists, the Baota deploy script starts docker-compose.proxy.yml and forces
# external HTTP(S) traffic through this address.
NOFX_FIXED_PROXY_URL=http://nofx-proxy:18080
NOFX_PROXY_PORT=18080
NOFX_PROXY_EXPECTED_IP=

DB_TYPE=postgres
DB_HOST=10.
DB_PORT=5432
DB_USER=nofx_user
DB_PASSWORD=
DB_NAME=nofx
DB_SSLMODE=disable


# Database configuration - SQLite (default)
DB_TYPE=sqlite
DB_PATH=data/data.db
